{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["season", "week", "phase", "status", "score_source", "teams", "matchups"],
  "properties": {
    "season": {"type": "integer"},
    "week": {"type": "integer", "minimum": 1, "maximum": 18},
    "phase": {"enum": ["regular", "playoffs"]},
    "status": {"enum": ["scheduled", "scored", "final"]},
    "teams": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["abbrev", "roster", "starter_count", "total_score"],
        "properties": {
          "abbrev": {"type": "string", "minLength": 2},
          "starter_count": {"const": 9},
          "total_score": {"type": "number", "minimum": 0},
          "roster": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["player_id", "name", "position", "score", "starter"],
              "properties": {
                "position": {"enum": ["QB", "RB", "WR", "TE", "K", "DF", "HC"]},
                "score": {"type": "number", "minimum": 0}
              }
            }
          }
        }
      }
    },
    "matchups": {"type": "array"}
  }
}
